# Use the pooler (Settings > Database > Connect > ORM > Prisma in the Supabase
# dashboard), not the direct db.<ref>.supabase.co host — that host is IPv6-only
# and unreachable from IPv4-only networks.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST].pooler.supabase.com:5432/postgres"

PORT=3001
NODE_ENV=development

NEXT_PUBLIC_APP_URL="http://localhost:3000"

JWT_SECRET="replace-with-a-long-random-secret"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
# Server-only. Bypasses RLS entirely — never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY="eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
